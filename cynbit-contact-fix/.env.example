# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5001

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Optional: Reverse Proxy Trust Configuration (false, true, loopback, linklocal, uniquelocal, or number of hops)
# TRUST_PROXY=false

# Optional: Redis URL for Distributed Rate Limiting Across Multiple Server Instances
# REDIS_URL=redis://localhost:6379

# Frontend API Endpoint (Vite Client)
VITE_API_URL=http://localhost:5001/api
