# =================================================================
# Cynbit Architecture Discovery Engine — Environment Configuration
# =================================================================

# Server Port (Default: 5001)
PORT=5001

# Application Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma ORM)
# If left commented or unset, the server automatically engages the
# clearly labeled Local Development Fallback Store (server/data/inquiries.json).
# DATABASE_URL="postgresql://cynbit_user:secure_password@localhost:5432/cynbit_inquiries?schema=public"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Frontend API Endpoint (Vite Client)
VITE_API_URL=http://localhost:5001/api

